APP_BASE_URL=https://calendar.example.com
MASTODON_BASE_URL=https://mastodon.example.com
MASTODON_CLIENT_ID=replace-with-your-client-id
MASTODON_CLIENT_SECRET=replace-with-your-client-secret
ADMIN_ACCOUNTS=admin@example.com
PORT=9100

# Supabase storage for the TimeGrid calendar app. Mastodon does not use these.
# Use the service-role key only on the server, never in browser JavaScript.
TIMEGRID_STORAGE=json
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-browser-safe-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Current production auth is Mastodon-only. Keep these false unless the related
# providers and SMTP/email delivery are intentionally configured.
TIMEGRID_ENABLE_EMAIL_AUTH=false
TIMEGRID_ENABLE_EXTERNAL_AUTH=false
# Local/browser QA only. Never enable this in production.
TIMEGRID_ENABLE_TEST_LOGIN=false
